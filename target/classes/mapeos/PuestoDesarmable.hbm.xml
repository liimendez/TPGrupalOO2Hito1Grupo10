<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <joined-subclass name="datos.PuestoDesarmable" extends="datos.UnidadVenta" table="puesto_desarmable">
        <key column="id"/>
        <property name="cantidadCarpas" column="cantidad_carpas" type="integer" not-null="true"/>
        <property name="tiempoMontajeMin" column="tiempo_montaje_min" type="integer" not-null="true"/>
    </joined-subclass>
</hibernate-mapping>