<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <joined-subclass name="datos.FoodTruck" extends="datos.UnidadVenta" table="food_truck">
        <key column="id"/>
        <property name="patente" column="patente" type="string" not-null="true" unique="true" length="10"/>
        <property name="requiereConexionElectrica" column="requiere_conexion_electrica" type="boolean" not-null="true"/>
    </joined-subclass>
</hibernate-mapping>