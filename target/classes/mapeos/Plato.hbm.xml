<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="datos.Plato" table="plato">

        <!-- ID -->
        <id name="id" column="id">
            <generator class="identity"/>
        </id>

        <!-- Atributos - Columnas -->
        <property name="nombre"
                  column="nombre"
                  type="string"
                  not-null="true"/>

        <property name="precioVenta"
                  column="precio_venta"
                  type="double"
                  not-null="true"/>

        <property name="costoProduccion"
                  column="costo_produccion"
                  type="double"
                  not-null="true"/>

        <!-- Relación con UnidadVenta -->
        <many-to-one name="unidadVenta"
                     class="datos.UnidadVenta"
                     column="unidad_venta_id"/>

    </class>

</hibernate-mapping>
