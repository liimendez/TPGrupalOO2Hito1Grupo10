<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="datos.Festival" table="festival">
        <id name="id" column="id" access="field">
            <generator class="identity"/>
        </id>

        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="temporada" column="temporada" type="string" not-null="true"/>
        <property name="fechaInicio" column="fecha_inicio" type="java.time.LocalDate" not-null="true"/>
        <property name="fechaFin" column="fecha_fin" type="java.time.LocalDate" not-null="true"/>

        <!-- Un Festival tiene muchas UnidadesVenta -->
        <set name="unidadesVenta" inverse="true" cascade="all">
            <key column="festival_id"/>
            <one-to-many class="datos.UnidadVenta"/>
        </set>

    </class>
</hibernate-mapping>
