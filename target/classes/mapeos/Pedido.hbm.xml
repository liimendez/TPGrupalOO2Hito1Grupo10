<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="datos.Pedido" table="pedido">

        <id name="id" column="id" access="field">
            <generator class="identity"/>
        </id>

        <property name="fechaTransaccion"
                  column="fecha_transaccion"
                  type="java.time.LocalDate"
                  not-null="true"/>

        <many-to-one name="festival"
                     class="datos.Festival"
                     column="festival_id"
                     not-null="true"/>

        <many-to-one name="unidadVenta"
                     class="datos.UnidadVenta"
                     column="unidad_venta_id"
                     not-null="true"/>

        <set name="detalles"
             cascade="all"
             inverse="true">

            <key column="pedido_id"/>

            <one-to-many class="datos.DetallePedido"/>

        </set>

    </class>

</hibernate-mapping>

